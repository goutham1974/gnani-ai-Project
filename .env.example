# ==============================================================
# RYTHUM AI - Configuration Environment
# Autonomous Multilingual AI Operating System for Indian Farmers
# ==============================================================

# Gnani.ai Speech Platform Credentials
# Get your API key from: https://app.gnani.ai/
GNANI_API_KEY=your_gnani_api_key_here
GNANI_BASE_URL=https://api.vachana.ai

# Gnani Prisma (Speech-to-Text) Settings
# Supported models: prisma-v3.0, prisma-v2.5
GNANI_STT_MODEL=prisma-v3.0
GNANI_STT_ENDPOINT=https://api.vachana.ai/stt/v3

# Gnani Timbre (Text-to-Speech) Settings
# Supported models: timbre-v3.0, timbre-v2.5
GNANI_TTS_MODEL=timbre-v3.0
GNANI_TTS_ENDPOINT=https://api.vachana.ai/api/v1/tts/inference
GNANI_DEFAULT_VOICE_TELUGU=Nalini
GNANI_DEFAULT_VOICE_HINDI=Nalini
GNANI_DEFAULT_VOICE_ENGLISH=Nalini

# Reasoning LLM / Gnani Evon / Gemini / OpenAI fallback
# Mode: "gemini" | "openai" | "evon_local" | "mock"
LLM_PROVIDER=mock
GEMINI_API_KEY=
OPENAI_API_KEY=
EVON_HF_MODEL_ID=GnaniAI/evon-3.3

# Weather API (Optional OpenWeatherMap key, preloaded with fallback Indian Mandal weather data)
WEATHER_API_KEY=

# Application & Database Settings
ENVIRONMENT=development
DATABASE_URL=sqlite:///./rythum.db
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
DEBUG=true

